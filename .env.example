# ---------------------------------------------------------------- AI layer
# Powers the public chat widget, the daily analysis narrative, agent
# suggestions, and voice-note transcription.
# NOTE: do NOT use the `gemini-flash-latest` alias on a free-tier key — its
# free allowance is a few dozen requests PER DAY. src/lib/ai.ts pins a model
# chain instead.
GEMINI_API_KEY=

# ------------------------------------------------------- scheduled analysis
# Shared secret between netlify/functions/daily-analysis.mts and
# /api/analytics/run. Without it the route refuses to run in production.
CRON_SECRET=

# ------------------------------------------------------------------- admin
# Bearer token for scripts and curl against /api/admin/* and /api/agent/message.
# These return raw visitor messages and can mutate the live site — treat as a
# production credential.
ADMIN_TOKEN=

# Browser login for the dashboard at /admin. A browser cannot send a bearer
# header by navigating, so the dashboard uses a signed session cookie instead.
# Generate the hash and the session secret with:
#   node scripts/hash-password.mjs "your-password"
# If any of these three is missing, /admin redirects to a setup notice and
# refuses to authenticate anyone in production.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ------------------------------------------------------- WhatsApp Cloud API
# Provisioned in Meta Business Manager against a dedicated business number.
# WHATSAPP_VERIFY_TOKEN : any string you choose; entered in the Meta webhook UI
# WHATSAPP_APP_SECRET   : Meta App Secret, used to verify request signatures
# WHATSAPP_TOKEN        : permanent System User access token
# WHATSAPP_PHONE_NUMBER_ID : numeric id of the sending number
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ------------------------------------------------------ agent authorisation
# Comma-separated E.164 numbers allowed to drive each site's agent.
# An EMPTY value means the agent accepts nothing — this is the intended
# fail-closed default. A keyword alone must never grant write access.
AGENT_ALLOWED_SENDERS_ALTA=
AGENT_ALLOWED_SENDERS_HOSPITALITY=

# Optional: second site's public URL, surfaced in agent replies.
HOSPITALITY_SITE_URL=
